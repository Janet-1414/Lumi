# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
*.pyc
*.pyo
*.pyd

# ─── uv / Virtual environments ───────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Environment files — NEVER commit real .env files ────────────────────────
.env
.env.local
.env.*.local
backend/.env
frontend/.env.local
# Keep example files — they are safe to commit
!.env.example
!**/.env.example

# ─── Node / Next.js ───────────────────────────────────────────────────────────
node_modules/
.next/
out/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts

# ─── Database ─────────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ─── Test / Coverage ──────────────────────────────────────────────────────────
.coverage
coverage/
coverage.xml
htmlcov/
.pytest_cache/
.tox/
nosetests.xml
test-results/
playwright-report/
blob-report/

# ─── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Build artifacts ──────────────────────────────────────────────────────────
*.whl
*.tar.gz

# ─── uv lock (optional — some teams commit this, some don't) ─────────────────
# uv.lock

# ─── Secrets / Keys — extra safety net ───────────────────────────────────────
*.pem
*.key
*.cert
*.p12
secrets/
