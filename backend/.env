# ── Lumi Backend — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://lumi:your_password@localhost:5432/lumi_dev

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=9f3d7c8a6e2b41f0a5d9c7e3b8f1a4c6d2e7f9b1c3a5d8e6f0b2c4a7e9d1f3b
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Cookies ───────────────────────────────────────────────────────────────────
COOKIE_SECURE=false       # true in production (requires HTTPS)
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# ── Email ─────────────────────────────────────────────────────────────────────
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@lumifi.app
MAIL_FROM_NAME=Lumi
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6

# ── AI ────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
LANGSMITH_API_KEY=ls__your-langsmith-key
LANGSMITH_PROJECT=lumi
LANGCHAIN_TRACING_V2=true

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
