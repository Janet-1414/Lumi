# .env.docker
# Safe defaults for local Docker networking.
# Used by docker-compose.yml — never contains real secrets.

# ── Backend (inside Docker network) ──────────────────────────────────────────
# Note: db is the Docker service name — not localhost
DATABASE_URL=postgresql+asyncpg://lumi:lumi_dev_password@db:5432/lumi_dev

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=docker-dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
COOKIE_SECURE=false

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
