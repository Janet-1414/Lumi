# frontend/.gitignore
# Extra frontend-specific ignores on top of root .gitignore

# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Environment variables — NEVER commit
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vercel
.vercel/

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Test output
coverage/
playwright-report/
test-results/
blob-report/
